{
  "name": "react-querybuilder-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "start": "bun --hot ./utils/devapp/server.ts",
    "start:antd": "bun run --filter @react-querybuilder/antd start",
    "start:bootstrap": "bun run --filter @react-querybuilder/bootstrap start",
    "start:bulma": "bun run --filter @react-querybuilder/bulma start",
    "start:chakra": "bun run --filter @react-querybuilder/chakra start",
    "start:datetime": "bun run --filter @react-querybuilder/datetime start",
    "start:dnd": "bun run --filter @react-querybuilder/dnd start",
    "start:expr": "bun run --filter @react-querybuilder/expr start",
    "start:fluent": "bun run --filter @react-querybuilder/fluent start",
    "start:mantine": "bun run --filter @react-querybuilder/mantine start",
    "start:material": "bun run --filter @react-querybuilder/material start",
    "start:native": "bun run --filter @react-querybuilder/native start",
    "start:rqb": "bun run --filter react-querybuilder start",
    "start:re": "bun run --filter @react-querybuilder/rules-engine start",
    "start:prime": "bun run --filter @react-querybuilder/prime start",
    "start:tremor": "bun run --filter @react-querybuilder/tremor start",
    "build": "bun run --filter '{,@}react-querybuilder{,/}*' build",
    "build:concurrent": "concurrently --timings bun:build:core bun:build:rqb bun:build:antd bun:build:bootstrap bun:build:bulma bun:build:chakra bun:build:datetime bun:build:dnd bun:build:expr bun:build:fluent bun:build:mantine bun:build:material bun:build:native bun:build:prime bun:build:tremor",
    "build:sequential": "bun --bun run build:core && bun --bun run build:rqb && bun --bun run build:antd && bun --bun run build:bootstrap && bun --bun run build:bulma && bun --bun run build:chakra && bun --bun run build:datetime && bun --bun run build:dnd && bun --bun run build:expr && bun --bun run build:fluent && bun --bun run build:mantine && bun --bun run build:material && bun --bun run build:native && bun --bun run build:prime && bun --bun run build:tremor",
    "build:antd": "bun --bun run --filter @react-querybuilder/antd build",
    "build:bootstrap": "bun --bun run --filter @react-querybuilder/bootstrap build",
    "build:bulma": "bun --bun run --filter @react-querybuilder/bulma build",
    "build:chakra": "bun --bun run --filter @react-querybuilder/chakra build",
    "build:core": "bun --bun run --filter @react-querybuilder/core build",
    "build:core:main": "bun --bun run --filter @react-querybuilder/core build:main",
    "build:core:css": "bun --bun run --filter @react-querybuilder/core build:css",
    "build:datetime": "bun --bun run --filter @react-querybuilder/datetime build",
    "build:dnd": "bun --bun run --filter @react-querybuilder/dnd build",
    "build:expr": "bun --bun run --filter @react-querybuilder/expr build",
    "build:expr:main": "bun --bun run --filter @react-querybuilder/expr build:main",
    "build:expr:css": "bun --bun run --filter @react-querybuilder/expr build:css",
    "build:fluent": "bun --bun run --filter @react-querybuilder/fluent build",
    "build:mantine": "bun --bun run --filter @react-querybuilder/mantine build",
    "build:material": "bun --bun run --filter @react-querybuilder/material build",
    "build:native": "bun --bun run --filter @react-querybuilder/native build",
    "build:prime": "bun --bun run --filter @react-querybuilder/prime build",
    "build:rqb": "bun run --filter react-querybuilder build",
    "build:rqb:main": "bun --bun run --filter react-querybuilder build:main",
    "build:rqb:css": "bun run --filter react-querybuilder build:css",
    "build:re": "bun --bun run --filter @react-querybuilder/rules-engine build",
    "build:re:main": "bun --bun run --filter @react-querybuilder/rules-engine build:main",
    "build:re:css": "bun run --filter @react-querybuilder/rules-engine build:css",
    "build:tremor": "bun --bun run --filter @react-querybuilder/tremor build",
    "checkall": "bun install --frozen-lockfile && bun run build && bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run conformance:check && bun run are-the-types-wrong && bun run website:build:full",
    "lint": "oxlint",
    "test": "bun test:bun && bun test:coverage",
    "test:bun": "bun generate-prisma-client; bun test --randomize ./packages/core ./packages/rules-engine/src/**/*.test.ts ./packages/datetime/src/**/*.test.ts ./packages/expr/src/**/*.test.ts # <- Avoids *.test.tsx",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:antd": "bunx vitest run packages/antd --coverage --coverage.include 'packages/antd/src/**/*.{ts,tsx}'",
    "test:bootstrap": "bunx vitest run packages/bootstrap --coverage --coverage.include 'packages/bootstrap/src/**/*.{ts,tsx}'",
    "test:bulma": "bunx vitest run packages/bulma --coverage --coverage.include 'packages/bulma/src/**/*.{ts,tsx}'",
    "test:chakra": "bunx vitest run packages/chakra --coverage --coverage.include 'packages/chakra/src/**/*.{ts,tsx}' --coverage.exclude 'snippets/**'",
    "test:core": "bunx vitest run packages/core --coverage --coverage.include 'packages/core/src/**/*.{ts,tsx}' --coverage.exclude '*TestUtils.ts' --coverage.exclude 'prisma/generated/**' --coverage.exclude 'parse{CEL,SQL}/{cel,sql}Parser.ts' --coverage.exclude 'parse{Cypher,Gremlin,SPARQL}/parse{Cypher,Gremlin,SPARQL}.ts'",
    "test:datetime": "bunx vitest run packages/datetime --coverage --coverage.include 'packages/datetime/src/**/*.{ts,tsx}' --coverage.exclude '*TestUtils.ts' --coverage.exclude 'prisma/generated/**' --coverage.exclude 'index.{date-fns,dayjs,jsdate,luxon}.ts'",
    "test:dnd": "bunx vitest run packages/dnd --coverage --coverage.include 'packages/dnd/src/**/*.{ts,tsx}'",
    "test:expr": "bunx vitest run packages/expr --coverage --coverage.include 'packages/expr/src/**/*.{ts,tsx}'",
    "test:fluent": "bunx vitest run packages/fluent --coverage --coverage.include 'packages/fluent/src/**/*.{ts,tsx}'",
    "test:mantine": "bunx vitest run packages/mantine --coverage --coverage.include 'packages/mantine/src/**/*.{ts,tsx}'",
    "test:material": "bunx vitest run packages/material --coverage --coverage.include 'packages/material/src/**/*.{ts,tsx}'",
    "test:native": "bunx vitest run packages/native --coverage --coverage.include 'packages/native/src/**/*.{ts,tsx}'",
    "test:prime": "bunx vitest run packages/prime --coverage --coverage.include 'packages/prime/src/**/*.{ts,tsx}'",
    "test:re": "bunx vitest run packages/rules-engine --coverage --coverage.include 'packages/rules-engine/src/**/*.{ts,tsx}' --coverage.exclude 'components/**'",
    "test:rqb": "bunx vitest run packages/react-querybuilder --coverage --coverage.include 'packages/react-querybuilder/src/**/*.{ts,tsx}'",
    "test:tremor": "bunx vitest run packages/tremor --coverage --coverage.include 'packages/tremor/src/**/*.{ts,tsx}'",
    "typecheck:seq": "bun typecheck:antd && bun typecheck:bootstrap && bun typecheck:bulma && bun typecheck:chakra && bun typecheck:core && bun typecheck:datetime && bun typecheck:expr && bun typecheck:dnd && bun typecheck:fluent && bun typecheck:mantine && bun typecheck:material && bun typecheck:native && bun typecheck:prime && bun typecheck:rqb && bun typecheck:re && bun typecheck:tremor && bun typecheck:utils && bun typecheck:root && bun typecheck:examples && bun typecheck:website",
    "typecheck": "concurrently --timings --prefix-colors \"#0958d9,#712cf9,#00d1b2,#81e6d9,#663399,cyan,#eab308,#4078c0,#7fba00,#339af0,#007fff,#61dafb,#06b6d4,#82a7dd,#006633,#60a5fa,darkgray,dimgray,gray,blue\" --names antd,bootstrap,bulma,chakra,core,datetime,expr,dnd,fluent,mantine,material,native,prime,react-querybuilder,rules-engine,tremor,utils,root,examples,website bun:typecheck:antd bun:typecheck:bootstrap bun:typecheck:bulma bun:typecheck:chakra bun:typecheck:core bun:typecheck:datetime bun:typecheck:expr bun:typecheck:dnd bun:typecheck:fluent bun:typecheck:mantine bun:typecheck:material bun:typecheck:native bun:typecheck:prime bun:typecheck:rqb bun:typecheck:re bun:typecheck:tremor bun:typecheck:utils bun:typecheck:root bun:typecheck:examples bun:typecheck:website",
    "typecheck:antd": "./node_modules/typescript/bin/tsc -p packages/antd",
    "typecheck:bootstrap": "./node_modules/typescript/bin/tsc -p packages/bootstrap",
    "typecheck:bulma": "./node_modules/typescript/bin/tsc -p packages/bulma",
    "typecheck:chakra": "./node_modules/typescript/bin/tsc -p packages/chakra",
    "typecheck:core": "./node_modules/typescript/bin/tsc -p packages/core",
    "typecheck:datetime": "./node_modules/typescript/bin/tsc -p packages/datetime",
    "typecheck:dnd": "./node_modules/typescript/bin/tsc -p packages/dnd",
    "typecheck:expr": "./node_modules/typescript/bin/tsc -p packages/expr",
    "typecheck:fluent": "./node_modules/typescript/bin/tsc -p packages/fluent",
    "typecheck:mantine": "./node_modules/typescript/bin/tsc -p packages/mantine",
    "typecheck:material": "./node_modules/typescript/bin/tsc -p packages/material",
    "typecheck:native": "./node_modules/typescript/bin/tsc -p packages/native",
    "typecheck:prime": "./node_modules/typescript/bin/tsc -p packages/prime",
    "typecheck:rqb": "./node_modules/typescript/bin/tsc -p packages/react-querybuilder",
    "typecheck:re": "./node_modules/typescript/bin/tsc -p packages/rules-engine",
    "typecheck:tremor": "./node_modules/typescript/bin/tsc -p packages/tremor",
    "typecheck:examples": "./node_modules/typescript/bin/tsc -p examples",
    "typecheck:website": "./node_modules/typescript/bin/tsc -p website",
    "typecheck:utils": "./node_modules/typescript/bin/tsc -p utils",
    "typecheck:root": "./node_modules/typescript/bin/tsc -p ./tsconfig.json",
    "are-the-types-wrong": "concurrently --timings bun:attw:core bun:attw:rqb bun:attw:antd bun:attw:bootstrap bun:attw:bulma bun:attw:chakra bun:attw:datetime bun:attw:dnd bun:attw:expr bun:attw:fluent bun:attw:mantine bun:attw:material bun:attw:native bun:attw:prime bun:attw:tremor",
    "attw:antd": "attw --format table-flipped --pack ./packages/antd",
    "attw:bootstrap": "attw --format table-flipped --pack ./packages/bootstrap",
    "attw:bulma": "attw --format table-flipped --pack ./packages/bulma",
    "attw:chakra": "attw --format table-flipped --pack ./packages/chakra",
    "attw:core": "attw --format table-flipped --pack ./packages/core",
    "attw:datetime": "attw --format table-flipped --pack ./packages/datetime",
    "attw:dnd": "attw --format table-flipped --pack ./packages/dnd",
    "attw:expr": "attw --format table-flipped --pack ./packages/expr",
    "attw:fluent": "attw --format table-flipped --pack ./packages/fluent",
    "attw:mantine": "attw --format table-flipped --pack ./packages/mantine",
    "attw:material": "attw --format table-flipped --pack ./packages/material",
    "attw:native": "attw --format table-flipped --pack ./packages/native",
    "attw:prime": "attw --format table-flipped --pack ./packages/prime",
    "attw:re": "attw --format table-flipped --pack ./packages/rules-engine",
    "attw:rqb": "attw --format table-flipped --pack ./packages/react-querybuilder",
    "attw:tremor": "attw --format table-flipped --pack ./packages/tremor",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "conformance:check": "bun ./utils/conformance/check.ts",
    "conformance:generate": "bun ./utils/conformance/generate.tsx",
    "conformance:pack": "bun ./utils/conformance/pack.ts",
    "generate-examples": "bun ./examples/generateExamples.ts",
    "generate-parsers": "bun --bun run generate-sqlparser && bun --bun run generate-celparser && bun --bun generate-parsers-codemod",
    "generate-sqlparser": "bunx --bun ts-jison -n SQL -t typescript packages/core/src/utils/parseSQL/sql.jison --outfile packages/core/src/utils/parseSQL/sqlParser.ts",
    "generate-celparser": "bunx --bun ts-jison -n CEL -t typescript packages/core/src/utils/parseCEL/cel.jison --outfile packages/core/src/utils/parseCEL/celParser.ts",
    "generate-parsers-codemod": "sed -i 's/lexer = new \\(CEL\\|SQL\\)Lexer(/lexer: \\1Lexer = new \\1Lexer(/g' packages/core/src/utils/parse{CEL/cel,SQL/sql}Parser.ts",
    "generate-prisma-client": "./utils/gen-prisma-client.sh",
    "generate-shadcn-registry": "bun run --filter website generate-shadcn-registry",
    "update-mantine-css": "bun utils/update-mantine-css.ts",
    "outdated": "bun update --interactive --recursive",
    "reset-deps": "rm -rf node_modules packages/*/node_modules website/node_modules bun.lock bun.lockb && bun install --save-text-lockfile",
    "version": "bun version.ts && bun install && bun --bun run build && bun run generate-examples && bun run conformance:generate && git add examples packages website/package.json bun.lock utils/conformance/fixtures",
    "web": "bun run --filter website start",
    "web:skiptypedoc": "RQB_TYPEDOC_DONE=true bun run --filter website start",
    "website:clearrun": "bun run --filter website clear && bun run --filter website start",
    "website:clearbuild": "bun run --filter website clear && bun run --filter website build",
    "website:build": "bun run generate-shadcn-registry && bun run --filter website build",
    "website:build:full": "bun run generate-shadcn-registry && RQB_ALL_VERSIONS=true bun run --filter website build",
    "website:serve": "bun run --filter website serve",
    "website:deploy": "bun run --filter website deploy",
    "website:clear": "bun run --filter website clear"
  },

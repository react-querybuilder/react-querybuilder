{
  // Shared compiler options for all projects in this monorepo.
  // This file is NOT a project itself -- it has no `include`/`files`.
  // Every real project extends it. Relative paths below resolve relative to
  // THIS file (the one that declares them), not the inheriting config.
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUncheckedSideEffectImports": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["vitest/globals", "@testing-library/jest-dom", "node", "web", "bun"],
    "paths": {
      "react-querybuilder": ["./packages/react-querybuilder/src"],
      "react-querybuilder/history": ["./packages/react-querybuilder/src/history"],
      "@react-querybuilder/core": ["./packages/core/src"],
      "@react-querybuilder/rules-engine": ["./packages/rules-engine/src"],
      "@rqb-parsecel": ["./packages/core/src/utils/parseCEL"],
      "@rqb-parsejsonata": ["./packages/core/src/utils/parseJSONata"],
      "@rqb-parsejsonlogic": ["./packages/core/src/utils/parseJsonLogic"],
      "@rqb-parsemongodb": ["./packages/core/src/utils/parseMongoDB"],
      "@rqb-parsespel": ["./packages/core/src/utils/parseSpEL"],
      "@rqb-parsesql": ["./packages/core/src/utils/parseSQL"],
      "@rqb-devapp": ["./utils/devapp"],
      "@rqb-testing": ["./utils/testing"],
      "@rqb-dbpool": ["./utils/testing/pglite"],
      "@rqb-dbmongo": ["./utils/testing/mongo"],
      "@rqb-dbquerytestutils": ["./packages/core/src/utils/formatQuery/dbqueryTestUtils"],
      "@rqb-utils": ["./packages/core/src/utils"]
    }
  }
}
